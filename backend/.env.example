# Copy this file to `backend/.env` and fill in real values.
# NEVER commit `.env` -- it is gitignored on purpose. Every value below is a
# placeholder; none of these are real credentials.

# --- SnapTrade (brokerage holdings, read-only connection) ---
# From your SnapTrade personal dashboard (https://app.snaptrade.com/).
SNAPTRADE_CLIENT_ID=changeme-snaptrade-client-id
# SnapTrade consumer key, paired with the client id above (used for HMAC signing).
SNAPTRADE_CONSUMER_KEY=changeme-snaptrade-consumer-key
# Personal-tier accounts come with a pre-provisioned userId and userSecret
# for the account owner -- no registerUser API call needed.  Find both in
# your SnapTrade personal dashboard under API credentials.
SNAPTRADE_USER_ID=changeme-snaptrade-user-id
SNAPTRADE_USER_SECRET=changeme-snaptrade-user-secret

# --- Financial Modeling Prep (fundamentals) ---
# Free-tier key from https://site.financialmodelingprep.com/ (~250 req/day budget).
FMP_API_KEY=changeme-fmp-api-key

# --- Finnhub (news) ---
# Free-tier key from https://finnhub.io/ (60 calls/min budget).
FINNHUB_API_KEY=changeme-finnhub-api-key

# --- Anthropic (AI advisor) ---
# From https://console.anthropic.com/ -- keys look like `sk-ant-...`.
ANTHROPIC_API_KEY=sk-ant-placeholder-changeme

# --- SEC EDGAR ---
# data.sec.gov requires a descriptive User-Agent (app name + a real contact
# email) on every request, or it returns 403. No API key needed.
SEC_EDGAR_USER_AGENT=Rundown/0.1 (changeme@example.com)

# --- Access control ---
# Shared-secret bearer token every non-exempt route requires in
# `Authorization: Bearer <token>`. Generate a random value, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_BEARER_TOKEN=changeme-generate-a-random-token

# --- Database ---
# SQLite for the MVP; the driver string is the only thing that changes if
# this is ever swapped for Postgres later.
DATABASE_URL=sqlite+aiosqlite:///./rundown.db

# --- CORS ---
# JSON array of allowed browser origins. Secondary, browser-only
# restriction -- see API_BEARER_TOKEN above for the real access-control gate.
CORS_ORIGINS=["http://localhost:3000"]

# --- AI advisor model ---
# Anthropic model id. Kept in config (not hardcoded) since model ids
# deprecate on a rolling schedule.
CLAUDE_MODEL_ID=claude-sonnet-5

# --- Logging ---
LOG_LEVEL=INFO

# --- Cache TTLs (seconds) ---
# Positions: short TTL to avoid hammering SnapTrade on frontend polling.
POSITIONS_TTL_SECONDS=300
# Fundamentals: FMP free tier is ~250 requests/day, so refresh infrequently.
FUNDAMENTALS_TTL_SECONDS=86400
# News: Finnhub free tier is 60 calls/min; a few hours is plenty fresh.
NEWS_TTL_SECONDS=14400
# EDGAR filings: published filing text never changes once filed.
EDGAR_TTL_SECONDS=604800
