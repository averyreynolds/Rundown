# Copy this file to `frontend/.env.local` and fill in real values.
# NEVER commit `.env.local` -- it is gitignored on purpose.
#
# Both variables are server-only (no `NEXT_PUBLIC_` prefix): they're read
# by Server Components and Route Handlers under app/api/, never bundled
# into client-side JavaScript. See CLAUDE.md hard rule 3.

# Base URL of the running FastAPI backend (see backend/README.md).
RUNDOWN_API_BASE_URL=http://127.0.0.1:8000

# Must match backend/.env's API_BEARER_TOKEN exactly -- the backend rejects
# every request (except /health) that doesn't present this as
# `Authorization: Bearer <token>`.
RUNDOWN_API_BEARER_TOKEN=changeme-same-value-as-backend-API_BEARER_TOKEN
